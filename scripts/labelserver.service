[Unit]
Description=Family label print server
Documentation=https://github.com/mmoniz/printer-server
After=network-online.target cups.service
Wants=network-online.target
Requires=cups.service

[Service]
Type=simple
User=labelserver
Group=labelserver
WorkingDirectory=/opt/labelserver
Environment=LABELSERVER_QUEUE=labels
Environment=LABELSERVER_MAIL_DB=/opt/labelserver/data/mail.db
Environment=PYTHONUNBUFFERED=1
# Mail polling is off unless this file sets LABELSERVER_MAIL_HOST/USER/PASSWORD.
# The leading '-' means the unit still starts fine if the file doesn't exist.
EnvironmentFile=-/etc/labelserver/mail.env

# Port 80 so nobody has to remember a port number. CAP_NET_BIND_SERVICE lets an
# unprivileged user bind it without running the whole app as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Exactly one worker, not a load-balancing knob: PendingStore is a plain
# in-process dict (see the label-web-app skill for why), so a second worker
# process would have its own empty copy. An upload landing in worker A's
# memory and the browser's preview request landing on worker B is a 404 --
# concurrency within a worker comes from --threads instead.
ExecStart=/opt/labelserver/venv/bin/python -m gunicorn \
    --workers 1 --threads 4 --timeout 120 \
    --bind 0.0.0.0:80 \
    --access-logfile - --error-logfile - \
    "labelserver.app:create_app()"

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
# Not `strict`: ProtectSystem=strict plus ReadWritePaths for
# /opt/labelserver/data reliably left the mail database unwritable in
# testing -- `unable to open database file` even though the path, its
# ownership, and the loaded unit's ReadWritePaths all checked out, and even
# a plain `sudo -u labelserver touch` in that directory worked fine outside
# the sandbox. Root-caused a genuine systemd quirk to be more effort than it
# was worth to keep chasing. `full` only makes /usr, /boot and /etc
# read-only, leaving /run (the CUPS socket) and /opt (app code and the mail
# database) alone -- no ReadWritePaths needed for either.
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M

[Install]
WantedBy=multi-user.target
