# Configuration for receiving labels by email (see the label-web-app skill).
#
# Create a dedicated mailbox for this -- do not point it at a personal
# account. The Pi polls it read-only over IMAP; nothing here opens the Pi up
# to inbound connections.
#
# Copy this file to /etc/labelserver/mail.env, fill it in, and restart:
#   sudo cp scripts/mail.env.example /etc/labelserver/mail.env
#   sudo chmod 600 /etc/labelserver/mail.env
#   sudo systemctl restart labelserver
#
# LABELSERVER_MAIL_HOST=imap.gmail.com
# LABELSERVER_MAIL_USER=familyname.labels@gmail.com
# LABELSERVER_MAIL_PASSWORD=an-app-password-not-your-real-password
# LABELSERVER_MAIL_PORT=993
# LABELSERVER_MAIL_FOLDER=INBOX
# LABELSERVER_MAIL_POLL_SECONDS=300

# Print an attachment the moment it arrives, instead of waiting in /admin
# for someone to press Print. Only fires when the crop looks confidently
# like a real 4x6 label (the same "label_shaped" signal the web app's
# preview page shows) -- a full page or an uncertain crop still waits for
# a human. Off by default; a wrong auto-print wastes stock silently.
# LABELSERVER_MAIL_AUTOPRINT=1
